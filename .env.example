# Copy to .env. MongoDB must be a replica set (Atlas or local Docker).
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce?replicaSet=rs0
PORT=3000
APPLICATION_NAME=ecommerce
# Generate FOUR DIFFERENT values: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_USER=
ACCESS_TOKEN_ADMIN=
REFRESH_TOKEN_USER=
REFRESH_TOKEN_ADMIN=
BEARER_USER=Bearer
BEARER_ADMIN=Admin
SALT_ROUND=12
CORS_ORIGINS=http://localhost:5173
EMAIL_USER=
EMAIL_PASSWORD=
WEB_CLIENT_ID=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
CHECKOUT_SUCCESS_URL=http://localhost:5173/checkout/success?session_id={CHECKOUT_SESSION_ID}
CHECKOUT_CANCEL_URL=http://localhost:5173/checkout/cancel
